# Required when LabelAnalysis__Provider=OpenAI. Keep this server-side only.
OPENAI_API_KEY=

# Demo accepts only the included sample fixtures; OpenAI performs live image extraction.
LabelAnalysis__Provider=OpenAI
LabelAnalysis__Model=gpt-4o-mini
LabelAnalysis__TimeoutSeconds=15
LabelAnalysis__MaxBatchSize=5
LabelAnalysis__MaxFileSizeMb=10
